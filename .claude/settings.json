{
  "permissions": {
    "deny": ["Read(./.env)", "Edit(./.env)"],
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh\"" }
        ]
      }
    ]
  }
}
